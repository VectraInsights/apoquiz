# ============================================================
# Apostila Quiz — variaveis de ambiente
# Copie este arquivo para .env.local e preencha.
# Na Vercel: Project > Settings > Environment Variables
# ============================================================

# --- IA (opcional, mas recomendado) --------------------------
# Sem nenhuma chave o app ainda funciona: usa o gabarito
# detectado no PDF. Com chave, a IA limpa os enunciados,
# escreve explicacoes e resolve questoes sem gabarito.

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternativa: qualquer endpoint compativel com a API da OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
