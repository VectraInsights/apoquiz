# ============================================================
# ApoQuiz — variaveis de ambiente
# Copie este arquivo para .env.local e preencha.
# Na Vercel: Project > Settings > Environment Variables
# ============================================================

# --- IA (opcional, mas recomendado) --------------------------
# Sem nenhuma chave o app ainda funciona: usa o gabarito
# detectado no PDF. Com chave, a IA limpa os enunciados,
# escreve explicacoes e resolve questoes sem gabarito.

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternativa: qualquer endpoint compativel com a API da OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Login com Google / sincronizacao (opcional) -------------
# Sem estas variaveis o app funciona em modo local (localStorage).
# Com elas, o botao "Entrar com Google" aparece e os quizzes
# passam a ser sincronizados entre aparelhos.
#
# 1. Crie o projeto em https://supabase.com/dashboard
# 2. Rode o arquivo lib/supabase/schema.sql no SQL Editor
# 3. Ative o provider Google em Authentication > Providers
# 4. Adicione http://localhost:3000 e a URL da Vercel em
#    Authentication > URL Configuration > Redirect URLs
#
# As duas chaves abaixo ficam em Project > API Keys.
# A "anon" publica vai para o navegador; a "service_role" NAO
# deve ser exposta (este app nao precisa dela).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
